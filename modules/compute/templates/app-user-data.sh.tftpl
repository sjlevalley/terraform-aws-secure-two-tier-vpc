#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/two-tier-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf install -y python3 python3-pip amazon-cloudwatch-agent

if ! id two-tier-app >/dev/null 2>&1; then
  useradd \
    --system \
    --user-group \
    --no-create-home \
    --home-dir /opt/two-tier-app \
    --shell /sbin/nologin \
    two-tier-app
fi

install -d -o root -g two-tier-app -m 0750 /opt/two-tier-app

cat > /opt/two-tier-app/requirements.txt <<'REQUIREMENTS'
Flask>=3.1,<4
gunicorn>=23,<24
REQUIREMENTS

python3 -m venv /opt/two-tier-app/venv
/opt/two-tier-app/venv/bin/pip install --no-cache-dir \
  --requirement /opt/two-tier-app/requirements.txt

cat > /opt/two-tier-app/app.py <<'PYTHON'
#!/usr/bin/env python3

import socket
from flask import Flask, jsonify

app = Flask(__name__)


@app.after_request
def add_security_headers(response):
    response.headers["Cache-Control"] = "no-store"
    response.headers["X-Content-Type-Options"] = "nosniff"
    return response


@app.get("/health")
def health():
    return jsonify(status="healthy"), 200


@app.get("/api")
@app.get("/api/")
def api():
    return jsonify(
        message="Hello from the application tier",
        hostname=socket.gethostname(),
    )
PYTHON

chown -R root:two-tier-app /opt/two-tier-app
chmod 0750 /opt/two-tier-app
chmod 0640 /opt/two-tier-app/app.py /opt/two-tier-app/requirements.txt

touch /var/log/two-tier-app.log
chown two-tier-app:two-tier-app /var/log/two-tier-app.log
chmod 0640 /var/log/two-tier-app.log

cat > /etc/systemd/system/two-tier-app.service <<'SYSTEMD'
[Unit]
Description=Two-tier sample application service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=two-tier-app
Group=two-tier-app
WorkingDirectory=/opt/two-tier-app
ExecStart=/opt/two-tier-app/venv/bin/gunicorn --bind 0.0.0.0:8080 --workers 2 --access-logfile - --error-logfile - app:app
StandardOutput=append:/var/log/two-tier-app.log
StandardError=append:/var/log/two-tier-app.log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
SYSTEMD

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/two-tier-app.log",
            "log_group_name": "${app_service_log_group}",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/two-tier-bootstrap.log",
            "log_group_name": "${app_bootstrap_log_group}",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/messages",
            "log_group_name": "${app_system_log_group}",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 14
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
CWAGENT

chmod 0644 /etc/systemd/system/two-tier-app.service

systemctl daemon-reload
systemctl enable --now two-tier-app.service

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

for attempt in {1..10}; do
  if curl --fail --silent --show-error http://127.0.0.1:8080/health; then
    exit 0
  fi

  sleep 2
done

systemctl status two-tier-app.service --no-pager
exit 1
